<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup / device-transfer rules. The app keeps NOTHING worth restoring: the refresh
  token lives in the Android Keystore-backed secure storage (undecryptable on another device, so a
  restored copy could only produce a broken session) and the only preference is the UI language.
  Everything is therefore excluded from both cloud backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>

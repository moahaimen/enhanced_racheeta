# =============================================================================
# Racheeta Platform — environment variables
#
# Copy to `.env` for local development. NEVER commit `.env`.
# Every variable here is documented in docs/DEVELOPMENT.md and docs/RAILWAY.md.
# Backend variables are read by backend/config/settings.py (django-environ).
# Web variables must be prefixed VITE_ to be visible to the browser bundle.
# =============================================================================

# ---- Django core -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-generate-a-real-secret
# true only on a developer machine. Production MUST be false.
DEBUG=true
# Comma separated. Production example: racheeta.up.railway.app,racheeta.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database ----------------------------------------------------------------
# Matches docker-compose.yml. Railway injects DATABASE_URL automatically.
DATABASE_URL=postgres://racheeta:racheeta@localhost:5432/racheeta
# Seconds to keep DB connections open (0 = close after every request).
DB_CONN_MAX_AGE=60
# Seconds to wait when opening a DB connection (fails fast instead of hanging a worker).
DB_CONNECT_TIMEOUT=5

# ---- Browser origins ---------------------------------------------------------
# Comma separated, full origins (scheme + host + port).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Auth (JWT) --------------------------------------------------------------
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=14

# ---- Email -------------------------------------------------------------------
# django-environ URL. Development: consolemail:// (prints emails to stdout).
# Production: smtp://USER:PASSWORD@HOST:587?tls=True  (provider not chosen yet;
# `manage.py check` refuses console/locmem backends when DEBUG=false).
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=Racheeta <no-reply@racheeta.local>
# Seconds before a mail-server connection/send is abandoned (must stay well below
# GUNICORN_TIMEOUT: mail is sent synchronously inside the request).
EMAIL_TIMEOUT=10
# Public origin of the web app, used to build links inside emails.
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TIMEOUT_MINUTES=60
EMAIL_VERIFICATION_TIMEOUT_HOURS=24

# ---- Firebase (optional, disabled by default) --------------------------------
# apps.accounts.firebase.DisabledVerifier      -> /auth/firebase/exchange answers 503
# apps.accounts.firebase.FirebaseAdminVerifier -> needs `pip install firebase-admin`
#   and FIREBASE_CREDENTIALS_FILE = path to a service-account JSON that is
#   mounted/injected by the platform. NEVER commit that file.
FIREBASE_VERIFIER=apps.accounts.firebase.DisabledVerifier
FIREBASE_CREDENTIALS_FILE=

# ---- Push notifications (FCM, optional, disabled by default) -----------------
# PostgreSQL stays authoritative; push is a best-effort hint sent after commit.
# apps.notifications.push.DisabledPushSender       -> nothing is ever sent (default)
# apps.notifications.push.FirebaseAdminPushSender  -> real FCM delivery; needs
#   firebase-admin (in requirements/production.txt) and FIREBASE_CREDENTIALS_FILE
#   (the same service account as Firebase sign-in above; never commit it).
PUSH_SENDER=apps.notifications.push.DisabledPushSender

# ---- Optional ----------------------------------------------------------------
# Path prefix of the Django admin (obscurity only, not a security control).
ADMIN_URL_PATH=admin/
# Absolute path to the built web app (web/dist). Empty = API only.
SPA_DIST_DIR=
# Python logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# json (default; one JSON object per line, request_id included) or text.
LOG_FORMAT=json
# Number of reverse proxies in front of gunicorn. Railway: 1. Used so rate limiting keys
# on the real client IP; leave 0 when there is no proxy (never trust X-Forwarded-For blindly).
TRUSTED_PROXY_COUNT=0
# Extra origins the browser may call (CSP connect-src), comma separated. Normally empty:
# the web app only talks to its own origin.
CSP_CONNECT_SRC=
# Serve /api/docs, /api/schema. Always on when DEBUG=true; off by default in production.
API_DOCS_ENABLED=false
# gunicorn tuning (all optional; defaults in backend/config/gunicorn.conf.py):
#   WEB_CONCURRENCY=2  GUNICORN_TIMEOUT=60  GUNICORN_GRACEFUL_TIMEOUT=30
#   GUNICORN_KEEPALIVE=5  GUNICORN_MAX_REQUESTS=2000  GUNICORN_LOG_LEVEL=info
# Set to true only behind a TLS-terminating proxy (Railway). Enables HSTS etc.
SECURE_PROXY_SSL=false

# ---- Web (Vite) --------------------------------------------------------------
# Empty = same origin. The Vite dev server proxies /api and /health to the
# backend (VITE_DEV_PROXY_TARGET, default http://localhost:8000), and in
# production Django serves the build, so this normally stays empty.
VITE_API_BASE_URL=
